# Supabase Configuration
# Supabase loyihangizning URL va anon key'ini o'rnating
# Bu ma'lumotlarni https://app.supabase.com/project/YOUR_PROJECT/settings/api dan olishingiz mumkin
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
VITE_APP_ENV=development
VITE_APP_TITLE=Boshqaruv

# API Configuration
VITE_API_URL=http://localhost:3000

# JWT Secret (production'da o'zgartirish kerak, kamida 32 belgi)
VITE_JWT_SECRET=change-this-in-production-minimum-32-characters-long-secret-key

# Optional: Analytics & Monitoring
# VITE_SENTRY_DSN=https://your-sentry-dsn
# VITE_GA_ID=your-google-analytics-id
